# A pattern with a single quote and LIKE wildcards in the data.
query I
SELECT count(*) FROM ((SELECT id, name FROM pd_local WHERE name LIKE '%''%' EXCEPT ALL SELECT id, name FROM bolt_scan('gpu_pd') WHERE name LIKE '%''%') UNION ALL (SELECT id, name FROM bolt_scan('gpu_pd') WHERE name LIKE '%''%' EXCEPT ALL SELECT id, name FROM pd_local WHERE name LIKE '%''%'));
----
0

# Unsupported expressions (a function call) are evaluated by DuckDB and still agree.
query I
SELECT count(*) FROM ((SELECT id, name FROM pd_local WHERE length(name) = 4 EXCEPT ALL SELECT id, name FROM bolt_scan('gpu_pd') WHERE length(name) = 4) UNION ALL (SELECT id, name FROM bolt_scan('gpu_pd') WHERE length(name) = 4 EXCEPT ALL SELECT id, name FROM pd_local WHERE length(name) = 4));
----
0

# Predicates that match nothing, with and without a VARCHAR projection.
query I
SELECT count(*) FROM bolt_scan('gpu_pd') WHERE id > 100000;
----
0

query I
SELECT count(name) FROM bolt_scan('gpu_pd') WHERE id < 0;
----
0

# The replacement scan inherits the same pushdown.
query I
SELECT count(*) FROM ((SELECT id, name FROM pd_local WHERE a = 5 AND name LIKE 'e%' EXCEPT ALL SELECT id, name FROM bolt.gpu_pd WHERE a = 5 AND name LIKE 'e%') UNION ALL (SELECT id, name FROM bolt.gpu_pd WHERE a = 5 AND name LIKE 'e%' EXCEPT ALL SELECT id, name FROM pd_local WHERE a = 5 AND name LIKE 'e%'));
----
0

