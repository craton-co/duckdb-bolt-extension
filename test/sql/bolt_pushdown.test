# Integer overflow in a filter is an error, as in DuckDB (UINTEGER * UINTEGER overflows from
# u = 66000 on). Before the fix the GPU wrapped silently and returned rows.
statement error
SELECT count(*) FROM bolt_scan('gpu_pd') WHERE u * u > 0;
----
Overflow in multiplication

statement error
SELECT count(*) FROM bolt_scan('gpu_pd') WHERE id * id * id * id * 1000 > 0;
----
Overflow in multiplication

# --- Explicit CASTs (report 1.1.1): narrowing / float-to-int casts must keep DuckDB semantics ---

query I
SELECT count(*) FROM ((SELECT id FROM pd_local WHERE CAST(d AS INTEGER) = 3 EXCEPT ALL SELECT id FROM bolt_scan('gpu_pd') WHERE CAST(d AS INTEGER) = 3) UNION ALL (SELECT id FROM bolt_scan('gpu_pd') WHERE CAST(d AS INTEGER) = 3 EXCEPT ALL SELECT id FROM pd_local WHERE CAST(d AS INTEGER) = 3));
----
0

