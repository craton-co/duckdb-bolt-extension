# name: test/sql/bolt_pushdown.test
# description: Differential filter-pushdown tests: bolt_scan results must equal plain DuckDB for every predicate
# group: [bolt]
#
# Each query returns the size of the symmetric difference between the rows DuckDB selects from
# the local table and the rows bolt_scan selects from the uploaded copy; it must be 0. On the
# cuda-gpu backend the predicates are pushed into Craton Bolt; on host-planner-fallback DuckDB
# evaluates them, so the file passes trivially there but still checks the scan itself.
# Projecting the VARCHAR column `name` exercises the GPU filter + host gather path
# (execute_gpu_filter_take); projecting only numeric columns exercises the plain GPU path.
#
# Report 1.1.1 (fixed): only lossless widening CASTs are stripped; see "Explicit CASTs" below.
# Report 1.1.3 (fixed): integer arithmetic is no longer pushed, so overflow raises "Out of Range"
#   (see "Arithmetic" below).
# Report 1.1.2 (fixed by RFC-008): TIMESTAMPTZ predicates in non-UTC session time zones are
#   checked differentially in bolt_timestamptz.test.

require bolt

statement ok
PRAGMA bolt_clear_tables;

statement ok
CREATE TABLE pd_local AS
SELECT
    i::INTEGER AS id,
    CASE WHEN i % 13 = 0 THEN NULL ELSE (i % 7)::INTEGER END AS a,
    (i % 5)::BIGINT AS b,
    CASE WHEN i % 17 = 0 THEN NULL ELSE i * 0.25 END::DOUBLE AS d,
    (i % 9 - 4)::FLOAT AS f,
    CASE WHEN i % 11 = 0 THEN NULL
         WHEN i % 3 = 0 THEN 'north_' || i::VARCHAR
         WHEN i % 3 = 1 THEN 'south_' || i::VARCHAR
         ELSE 'east' END AS name,
    CASE WHEN i % 19 = 0 THEN NULL ELSE i % 2 = 0 END AS flag,
    DATE '2024-01-01' + (i % 60)::INTEGER AS dt,
    CASE WHEN i % 23 = 0 THEN NULL
         ELSE TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (i * 5) HOUR END AS ts,
    (i * 1.25)::DECIMAL(9, 2) AS dec,
    (i % 100)::SMALLINT AS small,
    (i * 1000)::UINTEGER AS u
FROM range(1, 401) t(i);

statement ok
COPY pd_local TO 'gpu_pd' (FORMAT bolt, USE_TMP_FILE FALSE);

# Sanity: the full scan is identical.
query I
SELECT count(*) FROM (
    (SELECT * FROM pd_local EXCEPT ALL SELECT * FROM bolt_scan('gpu_pd'))
    UNION ALL
    (SELECT * FROM bolt_scan('gpu_pd') EXCEPT ALL SELECT * FROM pd_local)
);
----
0

# --- Comparisons on every column type (numeric projection) ---

query I
SELECT count(*) FROM ((SELECT id, a FROM pd_local WHERE a = 3 EXCEPT ALL SELECT id, a FROM bolt_scan('gpu_pd') WHERE a = 3) UNION ALL (SELECT id, a FROM bolt_scan('gpu_pd') WHERE a = 3 EXCEPT ALL SELECT id, a FROM pd_local WHERE a = 3));
----
0

query I
SELECT count(*) FROM ((SELECT id FROM pd_local WHERE a != 3 EXCEPT ALL SELECT id FROM bolt_scan('gpu_pd') WHERE a != 3) UNION ALL (SELECT id FROM bolt_scan('gpu_pd') WHERE a != 3 EXCEPT ALL SELECT id FROM pd_local WHERE a != 3));
----
0

